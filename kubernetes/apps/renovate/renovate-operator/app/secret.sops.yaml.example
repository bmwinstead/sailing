# TODO(bryan): this is a PLACEHOLDER, not a real secret, and is intentionally
# NOT wired into kustomization.yaml or encrypted with SOPS.
#
# Before renovate-operator can actually run anything:
#   1. Copy this file to secret.sops.yaml (drop the .example suffix).
#   2. Fill in a real GitHub PAT with repo access for the repos you want
#      Renovate to manage.
#   3. Encrypt it in place:
#        sops --encrypt --in-place kubernetes/apps/renovate/renovate-operator/app/secret.sops.yaml
#   4. Add "./secret.sops.yaml" to app/kustomization.yaml's resources list.
#   5. Create a RenovateJob custom resource (installed by this chart's CRDs)
#      with `spec.secretRef: renovate-secret` so the operator picks up these
#      credentials — see https://github.com/mogenius/renovate-operator docs
#      (docs/getting-started.md) for the RenovateJob spec (platform,
#      autodiscover, schedule, etc).
---
apiVersion: v1
kind: Secret
metadata:
  name: renovate-secret
  namespace: renovate
type: Opaque
stringData:
  GITHUB_COM_USER: "CHANGEME-github-username"
  GITHUB_COM_TOKEN: "CHANGEME-github-pat"
  RENOVATE_TOKEN: "CHANGEME-github-pat"
