# TODO(bryan): this is a PLACEHOLDER, not a real secret, and is intentionally
# NOT wired into kustomization.yaml or encrypted with SOPS.
#
# Uses a GitHub App instead of a PAT — the operator's native integration
# mints short-lived installation tokens itself, no PAT and no External
# Secrets Operator required. See renovatejob.yaml.example for the CR that
# references this secret via `githubAppReference`.
#
# 1. Create the GitHub App (org settings → Developer settings → GitHub Apps):
#      https://github.com/organizations/<your-org>/settings/apps
#      - New GitHub App → leave Webhooks inactive for now (see
#        secret-webhook-token.sops.yaml for the optional instant-response
#        webhook setup — do that after this App exists) → add the permissions listed at
#        https://docs.renovatebot.com/modules/platform/github/#running-as-a-github-app
#      - Generate a private key (bottom of the App settings page) and save the .pem
#      - Note the App ID (top of the App settings page)
#      - Install App → select the repos to grant access to → note the Installation ID
#        from the redirect URL: .../settings/installations/<INSTALLATION_ID>
# 2. Copy this file to secret.sops.yaml (drop the .example suffix).
# 3. Fill in APP_ID, INSTALL_ID, and PEM (raw PEM contents — sops encrypts
#    stringData in place, no need to base64 it yourself).
# 4. Encrypt it in place:
#      sops --encrypt --in-place kubernetes/apps/renovate/renovate-operator/app/secret.sops.yaml
# 5. Add "./secret.sops.yaml" to app/kustomization.yaml's resources list.
# 6. Copy renovatejob.yaml.example to renovatejob.yaml, fill in
#    discoveryFilters, add it to app/kustomization.yaml too.
---
apiVersion: v1
kind: Secret
metadata:
  name: github-app-credentials
  namespace: renovate
  labels:
    renovate-operator.mogenius.com/allow-ref: "true"
type: Opaque
stringData:
  APP_ID: "CHANGEME-github-app-id"
  INSTALL_ID: "CHANGEME-github-app-installation-id"
  PEM: |
    CHANGEME-github-app-private-key-pem-contents
