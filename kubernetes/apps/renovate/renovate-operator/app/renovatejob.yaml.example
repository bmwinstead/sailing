# TODO(bryan): PLACEHOLDER — not wired into kustomization.yaml.
#
# Tells the operator what to actually run. Requires secret.sops.yaml (see
# secret.sops.yaml.example) to exist first. Fill in discoveryFilters for the
# org/repos you want Renovate to manage, then copy to renovatejob.yaml and
# add "./renovatejob.yaml" to app/kustomization.yaml's resources list.
---
apiVersion: renovate-operator.mogenius.com/v1alpha1
kind: RenovateJob
metadata:
  name: renovate-github
  namespace: renovate
spec:
  discoveryFilters:
    - CHANGEME-github-org/*
  provider:
    name: github
  image: renovate/renovate:43.104.1
  parallelism: 5
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
  schedule: "0 * * * *"
  githubAppReference:
    secretName: github-app-credentials
    appIdSecretKey: APP_ID
    installationIdSecretKey: INSTALL_ID
    pemSecretKey: PEM
