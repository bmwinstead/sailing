# TODO(bryan): this is a PLACEHOLDER, not a real secret, and is intentionally
# NOT wired into kustomization.yaml or encrypted with SOPS.
#
# Backs the Buildkite Agent Stack for Kubernetes controller
# (buildkite/agent-stack-k8s), which watches a Buildkite cluster's job queue
# over the Buildkite API and creates a Kubernetes Job per build step —
# there's no static pool of idle agent pods to size or scale.
#
# 1. In Buildkite: Agents -> Clusters -> create (or pick) a cluster, then
#    add a Queue inside it. The queue name must match config.tags
#    (`queue=<name>`) in helmrelease.yaml — "kubernetes" by default.
# 2. In that cluster's settings, copy the cluster's agent token.
# 3. Copy this file to secret-agent-token.sops.yaml (drop the .example
#    suffix).
# 4. Set `BUILDKITE_AGENT_TOKEN` below to the raw token value.
# 5. Encrypt it in place:
#      sops --encrypt --in-place kubernetes/apps/buildkite/agent-stack-k8s/app/secret-agent-token.sops.yaml
# 6. Add "./secret-agent-token.sops.yaml" to app/kustomization.yaml's
#    resources list.
#    Reconcile — the controller picks up the token via `agentStackSecret:
#    buildkite-agent-token` in helmrelease.yaml and starts polling the queue.
---
apiVersion: v1
kind: Secret
metadata:
  name: buildkite-agent-token
  namespace: buildkite
stringData:
  BUILDKITE_AGENT_TOKEN: CHANGEME-buildkite-cluster-agent-token
