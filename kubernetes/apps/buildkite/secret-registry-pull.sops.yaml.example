# TODO(bryan): this is a PLACEHOLDER, not a real secret, and is intentionally
# NOT wired into any kustomization.yaml or encrypted with SOPS.
#
# Credentials for Flux OCIRepository objects that pull from the Buildkite
# Packages registry (packages.buildkite.com/<org>/<registry>).
#
# 1. In Buildkite: Packages -> the registry -> Registry tokens -> create a
#    read-only token. (The OpenTofu provider has no resource for this.)
# 2. Copy this file to secret-registry-pull.sops.yaml (drop .example).
# 3. Set `password` to the token.
# 4. Set `namespace` to the namespace of the OCIRepository that uses it
#    (a secretRef must live in the same namespace).
# 5. Encrypt it in place:
#      sops --encrypt --in-place <path>/secret-registry-pull.sops.yaml
# 6. Add it to that app's kustomization.yaml resources and set on the
#    OCIRepository:
#      spec:
#        secretRef:
#          name: buildkite-registry-pull
---
apiVersion: v1
kind: Secret
metadata:
  name: buildkite-registry-pull
  namespace: CHANGEME-ocirepository-namespace
stringData:
  username: buildkite
  password: CHANGEME-buildkite-registry-read-token
