# TODO(bryan): this is a PLACEHOLDER, not a real secret, and is intentionally
# NOT wired into kustomization.yaml or encrypted with SOPS.
#
# Backs gh-app-auth (https://github.com/AmadeusITGroup/gh-app-auth), a git
# credential helper + gh CLI extension that mints short-lived GitHub App
# installation tokens on demand — replaces a long-lived PAT for both `git
# push`/`git clone` and `gh` itself (via `gh app-auth exec -- gh ...`).
# It's optional: the devbox works without it, just with `gh auth login`
# (PAT-style) instead.
#
# 1. Create a GitHub App (same steps as the renovate-operator PR's
#    secret.sops.yaml.example): org settings → Developer settings → GitHub
#    Apps → New GitHub App → generate + download a private key, note the
#    App ID, install it on the repos you want this devbox to push to.
# 2. Copy this file to secret-github-app.sops.yaml (drop .example).
# 3. Paste the raw .pem contents into `key` below.
# 4. Encrypt it in place:
#      sops --encrypt --in-place kubernetes/apps/claude-code/claude-code/app/secret-github-app.sops.yaml
# 5. Add "./secret-github-app.sops.yaml" to app/kustomization.yaml's resources list.
# 6. Reconcile, then inside the devbox pod (one-time, persists on the home PVC):
#      gh app-auth setup --app-id <id> \
#        --key-file /home/node/.github-app/private-key.pem \
#        --patterns "github.com/bmwinstead/*"
#      gh app-auth gitconfig --sync
---
apiVersion: v1
kind: Secret
metadata:
  name: claude-code-github-app
stringData:
  private-key.pem: |
    CHANGEME-github-app-private-key-pem-contents
